FROM pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime

# Prevent interactive prompts during apt installs
ENV DEBIAN_FRONTEND=noninteractive

# Ensure /tmp exists with proper sticky-bit permissions
RUN mkdir -p /tmp && chmod 1777 /tmp

# Install system libraries required by OpenCV
RUN apt-get update && apt-get install -y --no-install-recommends \
    libcurl4 \
    openssl \
    procps \
    libgl1 \
    libglib2.0-0 \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install Python packages
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    "numpy<2.0.0" \
    jupyterlab \
    ultralytics \
    mlflow \
    jupyter-server-proxy

# Configure default workspace
WORKDIR /workspace

# Expose Jupyter default port
EXPOSE 8888

# Launch JupyterLab locked to /workspace
ENTRYPOINT ["jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--allow-root", "--ServerApp.root_dir=/workspace"]